# Neon Postgres: Console → your project → Connect → pooled connection string
DATABASE_URL=

# Team login for the library and share-links pages. Client share links (/s/…, /p/…) stay public.
# Leave TEAM_PASSWORD empty to disable the login (local development only).
TEAM_PASSWORD=
# Any long random string. Changing it (or the password) signs everyone out.
AUTH_SECRET=
